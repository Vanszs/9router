{
  "name": "vansrouter-app",
  "version": "0.91.21",
  "description": "9Router web dashboard",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "lint:undef": "node scripts/lint-undef.cjs",
    "lint:reacthooks": "node scripts/lint-reacthooks.cjs",
    "lint": "eslint . --no-warn-ignored",
    "test": "npx vitest run -c tests/vitest.config.js",
    "test:watch": "npx vitest -c tests/vitest.config.js",
    "build": "node scripts/build.js",
    "start": "node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@swc/helpers": "^0.5.15",
    "@next/env": "^16.1.6",
    "@next/third-parties": "^16.2.9",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "confbox": "^0.2.4",
    "dompurify": "^3.2.7",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.55.1",
    "next": "^16.1.6",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "playwright-core": "^1.60.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "sql.js": "^1.14.1",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.2.0",
    "vitest": "^3.2.4"
  }
}
